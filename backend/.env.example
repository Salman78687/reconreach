# ── Plan Tier ─────────────────────────────────────────────────────────────────
# "free"  → uses only zero-cost tools (GitHub, Gravatar, WHOIS, EmailRep, LinkedIn, phonenumbers)
# "paid"  → adds Hunter.io, Apollo.io, Google CSE, Twitter/X on top of free sources
PLAN_TIER=free

# ── LLM (any OpenAI-compatible API) ──────────────────────────────────────────
# Examples:
#   Ollama on this machine, app in Docker: http://host.docker.internal:11434/v1
#   Ollama on this machine, no Docker:     http://localhost:11434/v1
#   vLLM / LM Studio on another server:    http://<server-ip>:8000/v1
#   OpenAI:                                https://api.openai.com/v1  (and set LLM_API_KEY)
LLM_API_BASE=http://host.docker.internal:11434/v1
# "EMPTY" works for most local servers; use a real key for hosted APIs
LLM_API_KEY=EMPTY
# e.g. llama3.1 (Ollama), meta-llama/Llama-4-Scout-17B-16E-Instruct (vLLM), gpt-4o-mini (OpenAI)
LLM_MODEL=llama3.1

# ── Free-Tier Optional Keys (work on free plan when configured) ──────────────
# These services have free tiers or cheap plans — no PLAN_TIER=paid needed.

# GitHub Personal Access Token (free, optional — increases rate limit from 60 to 5000 req/hr)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Have I Been Pwned — paid subscription — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Clearbit — free trial available — https://dashboard.clearbit.com/
CLEARBIT_API_KEY=

# Snov.io — 50 free credits/mo — https://app.snov.io/api-setting
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── Paid OSINT Sources (only used when PLAN_TIER=paid) ───────────────────────

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=

# Apollo.io — https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Google Custom Search — https://developers.google.com/custom-search/v1/introduction
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Twitter/X Bearer Token — https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./reconreach.db

# Origins allowed to call the API (comma-separated). Add your own URL if you
# serve the frontend from somewhere other than localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
