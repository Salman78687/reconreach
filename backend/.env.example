# ── Plan Tier ─────────────────────────────────────────────────────────────────
# "free"  → uses only zero-cost tools (GitHub, Gravatar, WHOIS, EmailRep, phonenumbers)
# "paid"  → adds Hunter.io, Apollo.io, Google CSE, Twitter/X on top of free sources
PLAN_TIER=free

# ── Self-Hosted LLM (OpenAI-compatible) ──────────────────────────────────────
LLM_API_BASE=http://YOUR_LLM_HOST:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct

# ── Free-Tier Optional Keys (work on free plan when configured) ──────────────
# These services have free tiers or cheap plans — no PLAN_TIER=paid needed.

# Have I Been Pwned — ~$3.50/mo — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Clearbit — free trial available — https://dashboard.clearbit.com/
CLEARBIT_API_KEY=

# Snov.io — 50 free credits/mo — https://app.snov.io/api-setting
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── Paid OSINT Sources (only used when PLAN_TIER=paid) ───────────────────────

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=

# Apollo.io — https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# GitHub Personal Access Token (optional — increases rate limit from 60 to 5000 req/hr)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Custom Search — https://developers.google.com/custom-search/v1/introduction
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Twitter/X Bearer Token — https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# NumVerify (phone validation) — https://numverify.com/
NUMVERIFY_API_KEY=

# Twilio (phone lookup) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./osint_cold_call.db
